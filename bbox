  say(kind === 'all' ? `표적 ${tasks.length}개를 전체 프레임에서 추적합니다…` : `${sel.name}: ${cur + 1}~${Bm + 1}번 프레임을 다시 추적합니다…`);
  const back = cur;
  paint();
