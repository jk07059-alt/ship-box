<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head><body>
<title>선박 박스 검수</title>
<style>
  /* Instrument panel: zoom editor on the left, full-frame overview + controls on the right,
     a per-frame status strip across the bottom. */
  :root{
    --ink:#14181d; --ink-2:#4a545f; --ink-3:#7c8793;
    --ground:#eef1f4; --panel:#ffffff; --edge:#d3dae1;
    --mark:#d99100;            /* the box */
    --probe:#0f7d8c;           /* actions, edited */
    --ok:#1f7a4d; --warn:#9a4b17; --weak:#c99a2e; --auto:#a9b4bf; --none:#e1e6ea; --abs:#6b5a4c;
    --sans:"IBM Plex Sans KR","Malgun Gothic",system-ui,sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",monospace;
  }
  @media (prefers-color-scheme:dark){ :root:not([data-theme="light"]){
    --ink:#e6ebf0; --ink-2:#a3aeba; --ink-3:#6f7a86;
    --ground:#13171b; --panel:#1b2127; --edge:#2e373f;
    --mark:#f0b429; --probe:#3fb6c6; --ok:#4cc08a; --warn:#e0924f; --weak:#d8b04a;
    --auto:#4d5966; --none:#252c33; --abs:#9c8775;
    color-scheme:dark; } }
  :root[data-theme="dark"]{
    --ink:#e6ebf0; --ink-2:#a3aeba; --ink-3:#6f7a86;
    --ground:#13171b; --panel:#1b2127; --edge:#2e373f;
    --mark:#f0b429; --probe:#3fb6c6; --ok:#4cc08a; --warn:#e0924f; --weak:#d8b04a;
    --auto:#4d5966; --none:#252c33; --abs:#9c8775;
    color-scheme:dark; }

  [hidden]{display:none!important}
  html,body{height:100%}
  body{background:var(--ground);color:var(--ink);font-family:var(--sans);margin:0}
  .wrap{max-width:1180px;margin:0 auto;padding-inline:16px;padding-block:20px 32px;
        display:flex;flex-direction:column;gap:16px}

  header{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 16px}
  h1{font-size:20px;font-weight:600;margin:0;letter-spacing:-.01em}
  .sub{color:var(--ink-2);font-size:13px;margin:0;flex:1 1 260px;min-width:0}
  .count{font-family:var(--mono);font-size:13px;color:var(--ink-2);margin:0;
         font-variant-numeric:tabular-nums}
  .count b{color:var(--ok);font-weight:600}
  .count i{font-style:normal;color:var(--warn)}

  .card{background:var(--panel);border:1px solid var(--edge);border-radius:6px;padding:12px;min-width:0}

  /* empty state */
  .drop{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:24px;padding:24px}
  @media (max-width:820px){ .drop{grid-template-columns:minmax(0,1fr)} }
  .drop.over{outline:2px dashed var(--probe);outline-offset:-8px}
  .drop h2{font-size:17px;font-weight:600;margin:0 0 6px}
  .drop p{margin:0;color:var(--ink-2);font-size:13px;line-height:1.6}
  .steps{margin:14px 0 18px;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;
         counter-reset:s}
  .steps li{counter-increment:s;display:flex;gap:10px;font-size:13px;color:var(--ink);line-height:1.5}
  .steps li::before{content:counter(s);flex:none;width:20px;height:20px;border-radius:50%;
         display:grid;place-items:center;font-family:var(--mono);font-size:11px;
         background:var(--ground);border:1px solid var(--edge);color:var(--ink-2)}
  .fine{font-size:12px!important;color:var(--ink-3)!important;margin-top:10px!important}
  .saved h3{font-size:12px;font-weight:600;letter-spacing:.04em;color:var(--ink-3);margin:0 0 8px}
  .saved ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
  .saved li{border:1px solid var(--edge);border-radius:4px;padding:8px 10px;font-size:12.5px;
            display:flex;flex-direction:column;gap:2px;min-width:0}
  .saved li b{font-weight:500;overflow-wrap:anywhere}
  .saved li span{font-family:var(--mono);font-size:11.5px;color:var(--ink-3)}

  .cols{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start}
  @media (max-width:820px){ .cols{grid-template-columns:minmax(0,1fr)} }

  .stage{display:flex;flex-direction:column;gap:10px}
  .canvasbox{position:relative;width:100%;aspect-ratio:1/1;max-width:100%;
             background:#0a0d10;border-radius:4px;overflow:hidden;touch-action:none}
  #cv{display:block;width:100%;height:100%;cursor:crosshair}
  .meta{display:flex;flex-wrap:wrap;gap:6px 14px;font-family:var(--mono);
        font-size:11.5px;color:var(--ink-3);font-variant-numeric:tabular-nums}
  .meta b{color:var(--ink-2);font-weight:500}
  .chip{display:inline-block;padding:0 6px;border-radius:3px;color:#fff;font-weight:500}

  .ctrls{display:flex;flex-wrap:wrap;gap:8px}
  button{font-family:var(--sans);font-size:13px;font-weight:500;cursor:pointer;
         border-radius:4px;border:1px solid var(--edge);background:var(--panel);
         color:var(--ink);padding:7px 12px;transition:border-color .12s,background .12s}
  button:hover{border-color:var(--ink-3)}
  button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--probe);outline-offset:1px}
  button.go{background:var(--probe);border-color:var(--probe);color:#fff}
  button.go:hover{filter:brightness(1.08)}
  button.flag[aria-pressed="true"]{background:var(--warn);border-color:var(--warn);color:#fff}
  button:disabled{opacity:.45;cursor:default}

  .side{display:flex;flex-direction:column;gap:12px}
  .ovbox{position:relative;width:100%;background:#0a0d10;border-radius:4px;overflow:hidden;max-width:100%}
  #ov{display:block;width:100%;cursor:pointer}
  .lbl{font-size:11px;font-weight:600;letter-spacing:.05em;color:var(--ink-3);margin:0}
  .group{display:flex;flex-direction:column;gap:8px;padding-top:12px;border-top:1px solid var(--edge)}
  .row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .row button{flex:1 1 auto}
  .fileinfo{font-family:var(--mono);font-size:11.5px;color:var(--ink-2);line-height:1.6;
            overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
  label.f{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:12.5px;color:var(--ink-2)}
  input[type=number],select{font-family:var(--mono);font-size:12.5px;background:var(--panel);color:var(--ink);
        border:1px solid var(--edge);border-radius:4px;padding:5px 6px;width:90px}
  .bar{height:6px;background:var(--none);border-radius:3px;overflow:hidden}
  .bar i{display:block;height:100%;width:0;background:var(--probe);transition:width .2s}
  .prog{font-family:var(--mono);font-size:11.5px;color:var(--ink-3);font-variant-numeric:tabular-nums}

  .objs{display:flex;flex-direction:column;gap:4px}
  .obj{display:grid;grid-template-columns:12px minmax(0,1fr) auto;align-items:center;gap:8px;
       text-align:left;padding:6px 8px;font-size:12.5px}
  .obj i{width:12px;height:12px;border-radius:2px;background:var(--oc)}
  .obj .on{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .obj .oc{font-family:var(--mono);font-size:11px;color:var(--ink-3);font-variant-numeric:tabular-nums}
  .obj[aria-pressed="true"]{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
  .tl{display:flex;flex-direction:column;gap:8px}
  .tlhead{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px}
  .tlhead .jump{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:12px;color:var(--ink-2)}
  #tl{display:block;width:100%;height:30px;border-radius:3px;cursor:pointer;touch-action:none}
  .legend{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:11.5px;color:var(--ink-3)}
  .legend span{display:inline-flex;align-items:center;gap:5px}
  .legend span::before{content:"";width:10px;height:10px;border-radius:2px;background:var(--c)}

  .help{font-size:12px;color:var(--ink-3);line-height:1.65;margin:0}
  .help kbd{font-family:var(--mono);font-size:11px;background:var(--ground);
            border:1px solid var(--edge);border-radius:3px;padding:0 4px;color:var(--ink-2)}
  .status{font-size:12.5px;color:var(--ink-2);min-height:1.3em;margin:0}
  .status[data-tone="bad"]{color:var(--warn)}
  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
