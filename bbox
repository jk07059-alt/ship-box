    await job(async () => {
      await forward(tasks, busy.signal);
      for (const [o, s] of backs) if (!busy.signal.aborted) await backward(o, s, busy.signal);
    });
    const aborted = busy.signal.aborted;
    const {weak} = stats();
    say(aborted ? '추적을 중지했습니다. 지금까지의 결과는 남아 있습니다.'
