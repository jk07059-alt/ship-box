    const meta = m.exists ? m.data() || {} : null;
    if (!meta || meta.frames !== V.n) return 0;
    const list = meta.objects && meta.objects.length ? meta.objects : [{id: 1, name: '표적 1'}];
    objs = list.map(x => makeObj(x.id, x.name));
    nextId = Math.max(meta.nextId || 0, ...objs.map(o => o.id + 1));
    const snap = await db.collection(`videos/${V.key}/chunks`).get();
    for (const d of snap.docs) {
      const x = d.data(); if (!x) continue;
      const mm = /^o(\d+)_c\d+$/.exec(d.id);
      const o = objs.find(ob => ob.id === (mm ? +mm[1] : 1));      // old single-target chunks belong to target 1
      if (!o) continue;
      const a = x.start | 0;
      for (let i = 0; i < x.count && a + i < V.n; i++) {
        for (let k = 0; k < 4; k++) { const v = x.b[i*4+k], w = x.ab[i*4+k];
          o.B[(a+i)*4+k] = v == null ? NaN : v; o.AB[(a+i)*4+k] = w == null ? NaN : w; }
        o.S[a+i] = x.s[i] | 0; o.T[a+i] = +x.t[i] || 0; o.AT[a+i] = +x.at[i] || 0;
      }
    }
    return 1;
  } catch (e) { return 0; }
}
async function listSaved() {
  if (!db) return;
  try {
    const snap = await db.collection('videos').get();
    const items = snap.docs.map(d => d.data()).filter(Boolean).sort((a, b) => (b.updatedAt || '').localeCompare(a.updatedAt || ''));
    $('savedBox').hidden = !items.length;
    $('saved').replaceChildren(...items.slice(0, 8).map(x => {
      const li = document.createElement('li');
      const b = document.createElement('b'); b.textContent = x.name;
      const s = document.createElement('span');
      s.textContent = `${x.width}×${x.height} · ${x.frames}프레임 · 표적 ${(x.objects || [1]).length}개 · 확정 ${x.confirmed} · 불확실 ${x.uncertain}`;
      li.append(b, s); return li;
    }));
  } catch (e) {}
}

/* ======================================================================
   Export
   ====================================================================== */
function rowsFor(o, i) {
  const t = o.T[i]; if (!t) return null;
  const b = t === ABS ? null : boxO(o, i);
  return {id: o.id, name: o.name, box: b && b.map(v => +v.toFixed(2)),
          score: t < EDIT ? o.S[i] / 100 : null, status: ST_NAME[t === EDIT ? OK : t]};
}
async function offer(filename, data) {
  const url = URL.createObjectURL(new Blob([data], {type: filename.endsWith('.csv') ? 'text/csv' : 'application/json'}));
  const a = document.createElement('a'); a.href = url; a.download = filename;
  document.body.append(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 5000);
  say(filename + ' 파일을 내려받았습니다.');
}
const stem = () => V.name.replace(/\.[^.]+$/, '');
$('exJson').onclick = () => {
  const frames = [];
  for (let i = 0; i < V.n; i++) frames.push({frame: i + 1, t: +V.src.time(i).toFixed(4),
    targets: objs.map(o => rowsFor(o, i)).filter(Boolean)});
  offer(stem() + '_boxes.json', JSON.stringify({
    video: {name: V.name, width: V.w, height: V.h, frames: V.n, fps: V.src.fps},
    coords: 'original pixels, [x1, y1, x2, y2], frame is 1-based',
    targets: objs.map(o => ({id: o.id, name: o.name})), frames}, null, 1));
};
$('exCsv').onclick = () => {
  const L = ['frame,time_s,target_id,target_name,x1,y1,x2,y2,cx,cy,w,h,score,status'];
  for (let i = 0; i < V.n; i++) for (const o of objs) {
    const r = rowsFor(o, i); if (!r) continue;
    const b = r.box;
    L.push([i + 1, +V.src.time(i).toFixed(4), o.id, '"' + o.name.replace(/"/g, '""') + '"',
            ...(b ? [...b, (b[0]+b[2])/2, (b[1]+b[3])/2, b[2]-b[0], b[3]-b[1]].map(v => +(+v).toFixed(2)) : Array(8).fill('')),
            r.score ?? '', r.status].join(','));
  }
  offer(stem() + '_boxes.csv', L.join('\n') + '\n');
};

/* ======================================================================
   Opening a video
   ====================================================================== */
async function openVideo(file) {
  if (busy) return;
  await flushSave();
  $('intro').hidden = true; $('work').hidden = false;
  say('영상 정보를 읽는 중…');
  let src = null, why = '';
  try { src = await new Mp4Source().open(file); }
  catch (e) { why = e.message; try { src = await new VideoElSource().open(file); } catch (e2) { src = null; } }
  if (!src) {
    $('intro').hidden = false; $('work').hidden = true;
    say(''); alertIntro('이 영상은 브라우저에서 열 수 없습니다. H.264 mp4로 변환한 뒤 다시 열어 주세요.');
    return;
  }
  const key = (file.name.replace(/[^\w.-]+/g, '_').slice(0, 100) + '_' + file.size).replace(/^[._]+/, 'v');
  V = {file, key, name: file.name, src, w: src.w, h: src.h, n: src.n};
  objs = []; nextId = 1; clip = null;
  crops.clear(); ovs.clear(); dirty.clear(); dirtyMeta = false; wantFrame = -1; lastShown = 0;
  ov.height = Math.round(ov.width * V.h / V.w);
  win = Math.min(V.w >= 1500 ? 256 : 128, V.w, V.h); $('win').value = String(win);
  $('radius').value = V.w >= 1500 ? 24 : 12;
  const restored = await loadSaved();
  if (!objs.length) { objs = [makeObj(nextId++)]; }
  select(objs[0]);
  const seeds = objs.map(firstSeed).filter(s => s >= 0);
  cur = seeds.length ? Math.min(...seeds) : 0; vcx = V.w / 2; vcy = V.h / 2;
  if (hasBox(cur)) [vcx, vcy] = center(box(cur));
  $('ntot').textContent = V.n; $('jump').max = V.n;
  $('fileinfo').textContent = `${V.name} · ${V.w}×${V.h} · ${src.fps.toFixed(2)} fps · ${V.n}프레임 · ${src.kind === 'WebCodecs' ? src.codec : '영상 탐색 모드'}`;
  $('barfill').style.width = '0';
  $('prog').textContent = restored ? '저장된 결과를 불러왔습니다.' : '박스를 그리면 시작할 수 있습니다.';
  say(restored ? `이어서 작업합니다. 불확실한 프레임은 U 키로 찾아가세요.`
               : '오른쪽 전체 화면에서 선박을 클릭해 확대한 뒤 박스를 그리세요. 다른 선박은 「+ 새 표적」(N)으로 추가합니다.');
  if (src.kind !== 'WebCodecs') say('이 영상은 느린 탐색 모드로 읽습니다 (' + why + '). H.264 mp4면 훨씬 빠릅니다.');
  paint();
}
function alertIntro(msg) {
  let p = $('introErr');
  if (!p) { p = document.createElement('p'); p.id = 'introErr'; p.className = 'status'; p.dataset.tone = 'bad';
            $('intro').firstElementChild.append(p); }
  p.textContent = msg;
}
$('pick').onclick = () => $('file').click();
$('another').onclick = () => $('file').click();
$('file').onchange = () => { const f = $('file').files[0]; $('file').value = ''; if (f) openVideo(f); };
for (const ev of ['dragenter', 'dragover']) addEventListener(ev, e => { e.preventDefault(); $('intro').classList.add('over'); });
for (const ev of ['dragleave', 'drop']) addEventListener(ev, e => { e.preventDefault(); $('intro').classList.remove('over'); });
addEventListener('drop', e => { const f = e.dataTransfer && e.dataTransfer.files[0]; if (f) openVideo(f); });
addEventListener('resize', paint);

(async () => {
  try { localStorage.setItem(LS + 'probe', '1'); localStorage.removeItem(LS + 'probe'); db = lsdb; }
  catch (e) { db = null; }
  await listSaved();
})();
</script>

