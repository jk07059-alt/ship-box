    for (const o of objs) { const s = firstSeed(o); if (s >= 0) { tasks.push({o, a: s, b: V.n - 1}); if (s > 0) backs.push([o, s]); } }
    if (!tasks.length) { say('먼저 확대 화면에 선박 박스를 그려 주세요.', 'bad'); return; }
  } else {
    if (!sel || !hasBox(cur) || T[cur] === ABS) { say('이 프레임에 선택한 표적의 박스가 있어야 다시 추적할 수 있습니다.', 'bad'); return; }
    if (!manual(cur)) { T[cur] = OK; markDirty(sel, cur); }
    const b = nextManual(sel, cur) - 1;
    if (b <= cur) { say('바로 다음 프레임이 이미 확정된 프레임이라 추적할 구간이 없습니다.'); return; }
